ASPNETCORE_ENVIRONMENT=Production
PORT=10000
TelegramBot__Token=replace-with-rotated-telegram-token
TelegramBot__AuthorizedUserId=replace-with-telegram-numeric-user-id
ConnectionStrings__DefaultConnection=postgresql://your-user:replace-me@your-neon-host/neondb?sslmode=require
Moodle__BaseUrl=https://moodle.iugaza.edu.ps/
Moodle__LoginTimeoutSeconds=45
# Generate with: openssl rand -base64 32. Store only in Render, never in Git.
Moodle__SessionEncryptionKey=replace-with-32-random-bytes-base64
Moodle__SessionEncryptionKeyVersion=1
# During rotation, keep previous keys by version: Moodle__PreviousSessionEncryptionKeys__1=old-base64-key
Moodle__ScanIntervalMinutes=10
